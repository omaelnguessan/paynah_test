                "key": "x-api-secret",
                "value": "{{internal_api_secret}}"
              }
            ],
            "url": {
              "raw": "{{accounts_url}}/accounts/{{source_wallet_reference}}/credit",
              "host": [
                "{{accounts_url}}"
              ],
              "path": [
                "accounts",
                "{{source_wallet_reference}}",
                "credit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"postman-credit-{{$timestamp}}\",\n  \"amount\": 5000,\n  \"currency\": \"XOF\",\n  \"description\": \"Credit direct\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Debit without credentials → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-correlation-id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": {
              "raw": "{{accounts_url}}/accounts/{{source_wallet_reference}}/debit",
              "host": [
                "{{accounts_url}}"
              ],
              "path": [
                "accounts",
                "{{source_wallet_reference}}",
                "debit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"postman-unauthorised-{{$timestamp}}\",\n  \"amount\": 5000,\n  \"currency\": \"XOF\",\n  \"description\": \"No key\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the guard refuses it', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "transactions",
