  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Requests are readable on their own: nothing here mutates state.",
          "if (!pm.environment.get('correlation_id')) {",
          "  pm.environment.set('correlation_id', 'postman-' + Date.now());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('the response is enveloped', () => {",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property('code');",
          "  pm.expect(body).to.have.property('message');",
          "  pm.expect(body).to.have.property('data');",
          "});"
        ]
      }
    }
  ]
