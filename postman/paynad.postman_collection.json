              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"postman-movement-{{$timestamp}}\",\n  \"payment_reference\": \"{{payment_reference}}\",\n  \"type\": \"DEBIT\",\n  \"wallet_reference\": \"{{source_wallet_reference}}\",\n  \"user_reference\": \"{{user_reference}}\",\n  \"amount\": 5000,\n  \"currency\": \"XOF\",\n  \"description\": \"Mouvement manuel\",\n  \"status\": \"Approved\",\n  \"occurred_at\": \"2026-09-06T10:15:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 on a fresh append, 200 with the stored row on a replay."
          }
        },
        {
