# ---------------------------------------------------------------------------
# Copy to .env before `make up`. Nothing in docker-compose.yml is hard-coded:
# every value the stack needs is read from here.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=paynad
NODE_ENV=development
LOG_LEVEL=debug
DB_LOGGING=false

# --- PostgreSQL: one instance per service, never a shared database ----------
POSTGRES_VERSION=16-alpine

ACCOUNTS_DB_NAME=accounts
ACCOUNTS_DB_USER=accounts_user
ACCOUNTS_DB_PASSWORD=accounts_pwd
ACCOUNTS_DB_HOST=pg-accounts
ACCOUNTS_DB_PORT=5432
ACCOUNTS_DB_EXPOSED_PORT=5433

TRANSACTIONS_DB_NAME=transactions
TRANSACTIONS_DB_USER=transactions_user
TRANSACTIONS_DB_PASSWORD=transactions_pwd
TRANSACTIONS_DB_HOST=pg-transactions
TRANSACTIONS_DB_PORT=5432
TRANSACTIONS_DB_EXPOSED_PORT=5434

PAYMENTS_DB_NAME=payments
PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=payments_pwd
PAYMENTS_DB_HOST=pg-payments
PAYMENTS_DB_PORT=5432
PAYMENTS_DB_EXPOSED_PORT=5435

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_VERSION=3.13-management-alpine
RABBITMQ_USER=paynad
RABBITMQ_PASSWORD=paynad_pwd
RABBITMQ_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_EXPOSED_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Internal service-to-service credentials -------------------------------
# Guard the credit/debit endpoints of `accounts`. Generate your own before
# anything leaves a laptop:  openssl rand -hex 24
INTERNAL_API_KEY=dev-internal-key-change-me
INTERNAL_API_SECRET=dev-internal-secret-change-me-0123456789

# --- Applications -----------------------------------------------------------
ACCOUNTS_PORT=3001
TRANSACTIONS_PORT=3002
PAYMENTS_PORT=3003

ACCOUNTS_DEBUG_PORT=9229
TRANSACTIONS_DEBUG_PORT=9230
PAYMENTS_DEBUG_PORT=9231

# Internal service-to-service URLs, resolved over the payment-net bridge.
ACCOUNTS_SERVICE_URL=http://accounts:3001
TRANSACTIONS_SERVICE_URL=http://transactions:3002

# Outbound HTTP behaviour of the payments orchestrator.
HTTP_TIMEOUT_MS=3000
HTTP_MAX_RETRIES=2
